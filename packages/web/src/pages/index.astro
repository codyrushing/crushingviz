---
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/Card.astro';
import { Image } from 'astro:assets';
import PacificFloodingThumbDark from "../images/pacific-flooding-thumb-dark.png";
import PacificFloodingThumbLight from "../images/pacific-flooding-thumb-light.png";
import CovidDashboardThumb from "../images/covid-dashboard-thumb.png";
import AnimatedBackground from "../components/AnimatedBackground.astro";
---

<PageLayout title="Data viz portfolio by Cody Rushing" showFooter={true}>

  <!-- BIO  -->
  <section class="standard-spacing container flex flex-col gap-4">
    <h2 class="font-monospace">CrushingViz Projects</h2>
    <p class="text-lg md:text-2xl">
      Below is a collection of data apps and visualizations created by <a href="https://github.com/codyrushing" title="GitHub" target="_blank">Cody Rushing</a>
		</p>
		<div class="bg-surface border-border border py-4 px-2 rounded-full">
 			<nav class="links flex flex-wrap gap-4 justify-center text-sm">
				<a href="https://github.com/codyrushing" title="GitHub" target="_blank">github</a>
				<a href="mailto:codyrushing@pm.me">email</a>
				<a href="https://www.linkedin.com/in/crushing/" title="LinkedIn" target="_blank">linkedin</a>
				<a href="/resume" title="Resume/CV">resume/cv</a>
 			</nav>
		</div>
	</section>

	<AnimatedBackground class="w-full h-20" />

  <!-- WORKS SECTION  -->
  <div class="container standard-spacing flex-1 flex flex-col justify-center relative">
    <div class="flex flex-col gap-6">
      <!-- <h2 class="font-serif text-xl">Projects</h2> -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <Card href="/pacific-disaster-impact" title="Disaster Impact in the Pacific">
          <div slot="image" class="aspect-[16/9]">
            <Image class="dark:hidden w-full h-full object-cover object-top" alt="Disaster Impact in the Pacific" src={PacificFloodingThumbLight} />
            <Image class="hidden dark:block w-full h-full object-cover object-top" alt="Disaster Impact in the Pacific" src={PacificFloodingThumbDark} />
          </div>
          Who is most affected by natural disasters in the Pacific?
        </Card>

        <Card href="https://observablehq.com/@codyrushing/covid-19-in-the-usa" title="COVID-19 in the USA">
          <div slot="image">
            <Image class="w-full h-full object-cover" alt="COVID-19 in the USA" src={CovidDashboardThumb} />
          </div>
          Tracking per-state historical patterns during the height of the COVID pandemic.
        </Card>

      </div>
    </div>
  </div>
</PageLayout>
