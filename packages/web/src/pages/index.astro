---
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/Card.astro';
import { Image } from 'astro:assets';
import PacificFloodingThumbDark from "../images/pacific-flooding-thumb-dark.png";
import PacificFloodingThumbLight from "../images/pacific-flooding-thumb-light.png";
import CovidDashboardThumb from "../images/covid-dashboard-thumb.png";

---

<PageLayout title="Data viz portfolio by Cody Rushing" showFooter={true}>
  <div class="flex-1 flex flex-col justify-center">
    <div class="container flex flex-col gap-6">
      <h2 class="font-serif text-xl">Works</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <Card href="/pacific-disaster-impact" title="Disaster Impact in the Pacific">
          <div slot="image" class="aspect-[16/9]">
            <Image class="dark:hidden w-full h-full object-cover object-top" alt="Disaster Impact in the Pacific" src={PacificFloodingThumbLight} />
            <Image class="hidden dark:block w-full h-full object-cover object-top" alt="Disaster Impact in the Pacific" src={PacificFloodingThumbDark} />
          </div>
          Who is most affected by natural disasters in the Pacific?
        </Card>

        <Card href="https://observablehq.com/@codyrushing/covid-19-in-the-usa" title="COVID-19 in the USA">
          <div slot="image">
            <Image class="w-full h-full object-cover" alt="COVID-19 in the USA" src={CovidDashboardThumb} />
          </div>
          Tracking per-state historical patterns during the height of the COVID pandemic.
        </Card>

      </div>
    </div>
  </div>
</PageLayout>
