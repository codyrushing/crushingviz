---
import PageLayout from "../layouts/PageLayout.astro";
import EnvelopeIcon from "../icons/envelope.astro";
import GithubIcon from "../icons/github.astro";
import LinkedinIcon from "../icons/linkedin.astro";
import FilePDF from "../icons/file-pdf.astro";
---
<style>
  @reference "../styles/global.css";

	.brief {
		@apply leading-6 mb-3 flex flex-col gap-1 lg:flex-row lg:gap-4 items-baseline;
	}

	.brief .company,
	.brief .position,
	.brief .duration {
		@apply block;
		@apply lg:inline;
	}

	.brief h3 {
		@apply text-xl leading-none font-sans font-bold;
	}

	.brief h3, .brief > span {
		white-space: nowrap;
	}

	.brief .position {
		@apply text-muted-medium font-sans font-bold;
	}

	.brief .duration {
		@apply text-xs text-muted-medium;
	}

	.brief .duration span:last-child:before {
		content: '-';
		display: inline;
		@apply px-1;
		margin-right: 2px;
	}

	.role-item {
	  @apply py-4 md:py-6 lg:py-8 border-muted first:pt-0;
	}

	.role-details ul {
		@apply list-outside pl-4;
	}

	.role-details ul ul {
	  list-style: square;
		@apply text-sm pl-4 text-muted-medium;
	}

	.role-details > ul > li:not(:first-child){
		@apply mt-3;
	}

	.skills-list > li {
		@apply whitespace-nowrap list-none px-3 py-0.5 rounded-full bg-accent-500 text-center font-bold text-gray-100;
	}

	a.icon-link:hover span {
		text-decoration-style: solid;
	}

	nav a.icon-link span {
		text-decoration: none;
	}

	@media print {
		html,
		body {
			font-size: 12px;
			background: white;
			color: #222 !important;
		}

		.brief {
		  @apply flex-row gap-4;
		}

		a {
			color: inherit !important;
		}

		.role-details ul {
			@apply ml-2;
		}

		.hide-from-print {
			display: none;
		}

		.skills-list > li {
			@apply px-0 flex items-center gap-2 leading-none;
			color: #222;
			background: none;
			border: none;
		}

		.skills-list > li:not(:first-child):before {
		  content: '•';
			@apply inline-block self-center;
		}

		.education .info {
		  flex-direction: row;
		  @apply flex-row;
		}

	}
</style>
