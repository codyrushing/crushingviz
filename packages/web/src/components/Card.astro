---
interface Props {
  href: string;
  title?: string;
}

const { href, title } = Astro.props;
---

<a href={href} class="card group">
  {Astro.slots.has("image") && (
    <div class="card-image">
      <slot name="image" />
    </div>
  )}
  <div class="card-content">
    {title && <h3 class="card-title">{title}</h3>}
    <div class="card-body">
      <slot />
    </div>
  </div>
</a>

<style>
@reference "../styles/global.css";

.card {
  @apply block rounded-lg border border-border bg-surface no-underline overflow-hidden;
  transition: border-color 0.15s ease, transform 0.15s ease;
}

.card:hover {
  border-color: var(--color-accent);
  transform: translateY(-2px);
}

.card-image {}

.card-title {
  @apply font-serif leading-none text-foreground;
  @apply text-xl md:text-2xl;
  margin-block-end: 0.75rem;
  transition: color 0.15s ease;
}

.card-content {
  @apply text-sm text-muted p-6;
  line-height: 1.5;
}

.card:hover .card-title {
  color: var(--color-accent);
}
</style>
