---
import '../styles/global.css';
import SiteHeader from "./structures/SiteHeader.astro";

const { showFooter }: {
  showFooter?: boolean
} = Astro.props;

export type ColorScheme = "light" | "dark";
export type ColorSchemeManager = {
  getColorScheme: () => ColorScheme
  setPreference: (pref: ColorScheme | null) => void
  subscribe: (cb: ((arg0: ColorScheme | null) => void)) => void
  unsubscribe: (cb: ((arg0: ColorScheme | null) => void)) => void
}
export type WindowExtended = Window & {
  colorSchemeManager: ColorSchemeManager
}

---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400..700;1,400..700&family=Inconsolata:wght@200..900&family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">

    <!-- DARK MODE MANAGEMENT -->
    <script is:inline>
    window.colorSchemeManager = (function _colorSchemeManager(){
      let subscribers = [];
      function init() {
        document.documentElement.classList.toggle(
          "dark",
          localStorage.theme === "dark" || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches),
        );
      }

      /**
      * @returns {"light" | "dark"}
      */
      function getColorScheme() {
        return localStorage.theme === "dark" || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
      }

      /**
      * @param {"light" | "dark" | null}
      */
      function setPreference(preference) {
        if (preference === null) {
          localStorage.removeItem("theme");
        }
        else {
          localStorage.theme = preference;
        }
        init();
        for (const sub of subscribers) {
          if (typeof sub === "function") {
            sub(preference);
          }
        }
      }

      function subscribe(cb) {
        subscribers.push(cb);
      }

      function unsubscribe(cb) {
        subscribers = subscribers.filter(_cb => _cb !== cb);
      }

      init();
      return {
        getColorScheme,
        setPreference,
        subscribe,
        unsubscribe
      };
    }());
    </script>
	</head>
	<body class="min-h-screen flex flex-col">
	  <SiteHeader />

		<main class="flex-1 flex flex-col container mx-auto p-4 lg:p-8">
			<slot />
		</main>

		{showFooter && <footer class="p-4 border-t-border border-t">

			<div class="container mx-auto text-center text-xs text-muted">

        <div class="flex gap-4 items-center justify-center">
          <a role="button" href="https://github.com/codyrushing">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4">
              <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          </a>
          <a role="button" href="https://www.linkedin.com/in/crushing/">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4">
              <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
            </svg>
          </a>
        </div>
			</div>
		</footer>}
	</body>
</html>
<style>
  @reference "../styles/global.css";
  main {
    h1:not(.unstyledd) {
      /*@apply text-6xl;*/
      @apply font-serif;
      @apply leading-none;
      @apply text-2xl sm:text-3xl md:text-5xl lg:text-6xl;
      font-size: clamp(3rem,9vw,6rem);
    }

    h2:not(.unstyled) {
      @apply font-serif;
      @apply leading-none;
      @apply text-lg md:text-xl;
      @apply mt-8;
      font-size: clamp(2rem,8vw,3rem);
    }

    ul {
      @apply list-disc list-inside;
    }

    a {
      @apply text-blue-500 underline;
    }
  }
</style>
<script>
	document.querySelectorAll('a[href^="http"]').forEach((a) => {
		a.setAttribute("target", "_blank");
	});
</script>
