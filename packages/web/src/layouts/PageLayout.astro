---
import '../styles/global.css';
import SiteHeader from "./structures/SiteHeader.astro";
import LinkedinIcon from "../icons/linkedin.astro";
import GithubIcon from "../icons/github.astro";

const { showFooter, title, skipTitleSuffix }: {
  title: string,
  showFooter?: boolean,
  skipTitleSuffix?: boolean
} = Astro.props;

export type ColorScheme = "light" | "dark";
export type ColorSchemeManager = {
  getColorScheme: () => ColorScheme
  setPreference: (pref: ColorScheme | null) => void
  subscribe: (cb: ((arg0: ColorScheme | null) => void)) => void
  unsubscribe: (cb: ((arg0: ColorScheme | null) => void)) => void
}
export type WindowExtended = Window & {
  colorSchemeManager: ColorSchemeManager
}

const titleContent = [
  title,
  ...(!skipTitleSuffix ? ["Data and visualization projects by Cody Rushing"] : [])
].join(' - ');

---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{titleContent}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400..700;1,400..700&family=Inconsolata:wght@200..900&family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">

    <!-- DARK MODE MANAGEMENT -->
    <script is:inline>
    window.colorSchemeManager = (function _colorSchemeManager(){
      let subscribers = [];
      function init() {
        document.documentElement.classList.toggle(
          "dark",
          localStorage.theme === "dark" || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches),
        );
      }

      /**
      * @returns {"light" | "dark"}
      */
      function getColorScheme() {
        return localStorage.theme === "dark" || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
      }

      /**
      * @param {"light" | "dark" | null}
      */
      function setPreference(preference) {
        if (preference === null) {
          localStorage.removeItem("theme");
        }
        else {
          localStorage.theme = preference;
        }
        init();
        for (const sub of subscribers) {
          if (typeof sub === "function") {
            sub(preference);
          }
        }
      }

      function subscribe(cb) {
        subscribers.push(cb);
      }

      function unsubscribe(cb) {
        subscribers = subscribers.filter(_cb => _cb !== cb);
      }

      init();
      return {
        getColorScheme,
        setPreference,
        subscribe,
        unsubscribe
      };
    }());
    </script>
	</head>
	<body class="min-h-screen flex flex-col">
	  <SiteHeader />

		<main class="flex-1 flex flex-col">
			<slot />
		</main>

		{showFooter && <footer class="p-4 border-t-border border-t">

			<div class="container mx-auto text-center text-xs text-muted">

        <div class="flex gap-4 items-center justify-center">
          <a role="button" class="hover:text-foreground transition-colors" href="https://github.com/codyrushing">
            <GithubIcon class="size-4" />
          </a>
          <a role="button" class="hover:text-foreground transition-colors" href="https://www.linkedin.com/in/crushing/">
            <LinkedinIcon class="size-4" />
          </a>
        </div>
			</div>
		</footer>}

		<slot name="end" />

	</body>
</html>
<style>
  @reference "../styles/global.css";

  main {
    h1:not(.unstyled) {
      /*@apply text-6xl;*/
      @apply font-serif;
      @apply leading-none;
      @apply text-2xl sm:text-3xl md:text-5xl lg:text-6xl;
      font-size: clamp(3rem,9vw,6rem);
    }

    h2:not(.unstyled) {
      @apply font-serif;
      @apply leading-none;
      @apply text-lg md:text-xl;
      @apply mt-4;
      font-size: clamp(2rem,8vw,3rem);
    }

    ul {
      @apply list-disc list-inside;
    }

    a {
      @apply text-blue-500 underline;
      &:hover {
        opacity: 0.75;
      }
    }

    .modal-dialog::backdrop {
      background-color: rgb(0 0 0 / 0.5);
      backdrop-filter: blur(2px);
    }

    .modal-dialog {
      h1 {
        @apply text-xl;
      }
      h2 {
        @apply text-lg;
      }

      /* Markdown body rendered inside the modal */
      .modal-markdown {
        @apply text-sm leading-relaxed flex flex-col gap-3;
      }

      .modal-markdown p {
        @apply mt-2;
      }

      .modal-markdown h1 {
        @apply text-base font-serif font-bold mb-2;
      }
      .modal-markdown hr {
        @apply border-border my-4;
      }
      .modal-markdown ul {
        @apply list-disc pl-5 flex flex-col gap-2;
      }
      .modal-markdown a {
        @apply text-accent underline underline-offset-2;
      }
      .modal-markdown code {
        @apply font-mono text-xs bg-surface px-1 rounded;
      }

    }

  }
</style>
<script>
	document.querySelectorAll('a[href^="http"]').forEach((a) => {
		a.setAttribute("target", "_blank");
	});
</script>
