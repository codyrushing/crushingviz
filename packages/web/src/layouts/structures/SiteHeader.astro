---
import ColorSchemeSelector from "./ColorSchemeSelector.astro";


---
<header id="site-header" class="sticky top-0 z-1 p-2 lg:p-4 backdrop-blur-xs border-border border-b bg-background/75">
	<div class="container mx-auto flex items-center justify-between">
		<a href="/" class="flex flex-row items-center gap-1 font-monospace text-foreground text-sm dark:text-muted before:inline-block before:bg-muted before:h-[1.5px] before:rounded-full before:w-3 after:inline-block after:bg-accent-500 after:h-[1.5px] after:w-3 after:rounded-full">
		  crushing
			<span class="text-accent-500 -ml-0.5">viz</span>
		</a>
		<ColorSchemeSelector />
	</div>
</header>
<script>
	const header = document.getElementById("site-header");
	if (header) {
  	const threshold = 1;
  	let lastY = window.scrollY;
  	let lastTime = performance.now();
  	let velocity = 0;
  	let hidden = false;

  	const onScroll = () => {
  		const now = performance.now();
  		const y = window.scrollY;
  		const deltaY = y - lastY;
  		const dt = Math.max(now - lastTime, 1);
  		velocity = deltaY / dt;
  		lastY = y;
  		lastTime = now;

  		if (y <= 0) {
  			show();
  		} else if (velocity > threshold) {
  			hide();
  		} else if (velocity < -threshold) {
  			show();
  		}
  	};

  	const hide = () => {
  		if (hidden) return;
  		hidden = true;
  		header.style.transform = "translateY(-100%)";
  	};

  	const show = () => {
  		if (!hidden) return;
  		hidden = false;
  		header.style.transform = "translateY(0)";
  	};

  	header.style.transition = "transform 0.2s ease";
  	window.addEventListener("scroll", onScroll, { passive: true });

  	if (window.scrollY >= 40) hide();
 	}
</script>
