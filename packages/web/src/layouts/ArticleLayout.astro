---
import PageLayout from "./PageLayout.astro";
const { frontmatter }: {
  frontmatter?: { title?: string }
} = Astro.props;
const title = frontmatter?.title;
---
<PageLayout title={title}>
  <article>
    <slot />
  </article>
</PageLayout>

<style>
@reference "../styles/global.css";
article {
  @apply py-6 flex flex-col gap-4;
}

</style>
